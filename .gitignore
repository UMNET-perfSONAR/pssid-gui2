build/
node_modules/
log

# Ignore all output files except provision.sh, which ships by default so the
# application is usable without further configuration. Deployments may supply
# their own provision.sh.
services/server/output/*
!services/server/output/provision.sh
services/server/.env
/certs/*
**/certs/*
services/client/certs/*
mongo-backups/*
*.crt
*.key
*.pem
*.env

test-docker-compose.yml
services/database/init-mongo.js

# Installer-generated artifacts (host-specific, not for version control)
.env
.env.bak
nginx.conf.bak
www/

# Site-specific Ansible inventories (copied from remote.example.ini)
ansible/inventories/remote.ini

# Ansible Vault files holding a deployment's OIDC client id and secret. The
# inventories and group_vars beside them ARE tracked; the credentials are not.
# Matches group_vars/all/vault.yml and group_vars/<group>/vault.yml alike.
**/vault.yml

# Okta/SSO configuration runbook. Deliberately untracked: it is a working
# document an operator fills in with their own tenant name, application ids,
# group names and redirect URIs while setting single sign-on up. The
# vendor-neutral version of the same material lives in
# docs/deployment.md#single-sign-on, which IS tracked.
umich/QA/SSOwithOkta.md
# macOS folder metadata, never commit
.DS_Store

# The repo-root shared/ directory is staged into each service's src/shared at
# build time (Docker COPY, CI, and the `sync:shared` npm script). The copies are
# generated; the originals live in /shared.
services/client/src/shared/
services/server/src/shared/
