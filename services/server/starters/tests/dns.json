{
    "name": "dns",
    "parameters": [
        {
            "name":"nameserver",
            "type":"text",
            "default": "",
            "validator": "return input && !/\\s/.test(input);",
            "description": "nameserver should be nonempty and free of whitespace"
        },
        {
            "name":"record",
            "type":"singleselect",
            "options": [
                {"name": "a"},
                {"name": "aaaa"},
                {"name": "ns"},
                {"name": "cname"},
                {"name": "soa"},
                {"name": "ptr"},
                {"name": "mx"},
                {"name": "txt"}
            ],
            "default": { "name": "a" },
            "validator": "return true;",
            "description": "record should be one of the enum values, in lowercase"
        },
        {
            "name":"query",
            "type":"text",
            "default": "",
            "validator": "return input && !/\\s/.test(input);",
            "description": "query should be nonempty and free of whitespace"
        }
    ],
    "validator": "return true;",
    "category": "perfsonar"
}
