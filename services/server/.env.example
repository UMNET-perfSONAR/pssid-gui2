# Example server environment. install.sh generates the real file (root-owned,
# mode 640) and every value below with it; this copy documents what each one is
# for. Never commit the real .env: it holds the database password, the session
# secret and the OIDC client secret.
#
# The server VALIDATES these at startup and refuses to boot on a bad value rather
# than running with a silently weakened setting. See
# services/server/src/services/oidc.service.ts.

# MongoDB connection string. In Docker Compose this points to the mongo service.
# The installer writes an authenticated URI:
#   mongodb://<user>:<password>@mongo:27017/pssid?authSource=admin
MONGODB_URI=mongodb://mongo:27017/pssid

# Redis connection string. REQUIRED when ENABLE_SSO=true: Redis holds the session
# store. It must carry a password -- anything that reaches Redis can read or forge
# a signed-in session, and the startup check rejects a URL without one.
REDIS_URL=redis://:replace-with-a-redis-password@redis:6379

# Send Strict-Transport-Security on API responses. Set true ONLY with a CA-issued
# certificate. HSTS makes certificate errors non-bypassable, so with a
# self-signed certificate it locks every user out for the whole max-age.
HSTS_ENABLED=false

# Maximum request body. Every body this API legitimately accepts is a form's
# worth of JSON; oversized ones are rejected before they are parsed.
BODY_LIMIT=256kb

# --- Rate limits (per client IP, per minute) ---------------------------------
# nginx applies its own, looser, volumetric limits in front of these.
RATE_LIMIT_API_PER_MIN=200
RATE_LIMIT_WRITE_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=60

# NOTE: NODE_EXTRA_CA_CERTS does NOT work from this file.
#
# If your identity provider presents a certificate from an internal CA, or a
# TLS-inspecting proxy sits between this host and the provider, the server needs
# that CA or OIDC discovery fails with "self-signed certificate" and every
# sign-in returns 500. The usual fix is NODE_EXTRA_CA_CERTS -- but Node reads it
# when the process STARTS, and this file is loaded by dotenv afterwards, so a
# value here is silently ignored. Set it in the compose environment instead:
#
#   services:
#     server:
#       environment:
#         - NODE_EXTRA_CA_CERTS=/etc/ssl/certs/your-ca.pem
#       volumes:
#         - /path/to/your-ca.pem:/etc/ssl/certs/your-ca.pem:ro

# Read the group -> permission mapping from somewhere other than
# shared/auth-groups.config.json (a config-management directory, a mounted
# secret). When set this is the ONLY path consulted: if the file is missing the
# server refuses to start rather than silently falling back to the copy baked
# into the image, which would grant access through the shipped example group.
# AUTH_GROUPS_FILE=/etc/pssid/auth-groups.config.json

# --- SSO / OIDC (required when ENABLE_SSO=true) -----------------------------
# ENABLE_SSO itself lives in the ROOT .env (read by Docker Compose) and in
# shared/config.ts. docs/deployment-with-sso.md is the quick walkthrough;
# umich/QA/SSOwithOkta.md is the full provider-side runbook.

# The base URL of your OIDC identity provider's authorization server, with no
# trailing slash and no /.well-known suffix. The discovery document must be at
# <ISSUER_BASE_URL>/.well-known/openid-configuration.
# Okta org authorization server:  https://your-tenant.okta.com
ISSUER_BASE_URL=https://idp.example.com

# The public URL of this pSSID GUI deployment: an origin, no path, no trailing
# slash. The OIDC redirect URI is derived from it as <BASE_URL>/callback, and it
# is also the only origin CORS accepts.
BASE_URL=https://pssid-gui.example.edu

# Session cookie domain: a bare hostname, no scheme. LEAVE EMPTY unless you know
# you need it -- that is what the installer writes, and it gives a host-only
# cookie sent to exactly the host that set it. An explicit Domain is also sent to
# every SUBDOMAIN of it, and it breaks the loopback access path, since a browser
# used on the VM itself would have the cookie rejected as a domain mismatch and
# loop at sign-in. Set it only for one session across several hostnames; when set
# it must be the BASE_URL host or a parent of it, and the server refuses to start
# otherwise rather than let sign-in loop.
COOKIE_DOMAIN=

# OIDC client ID issued by your identity provider.
CLIENT_ID=your-client-id-here

# OIDC client secret issued by your identity provider.
CLIENT_SECRET=your-client-secret-here

# Signs the session cookie. At least 32 characters; a short value is guessable
# and the startup check rejects it. Generate one with: openssl rand -hex 32
SECRET=replace-with-a-long-random-string

# Scope requested at login. `groups` is what Okta and Entra ID need in order to
# release group membership. It is NOT universal: a provider with no scope by that
# name rejects the whole authorization request with invalid_scope. A federated
# higher-education tenant releasing the eduPerson attribute instead wants:
#   SSO_SCOPE=openid profile email edumember groups
SSO_SCOPE=openid profile email groups

# Session lifetime, in seconds. ABSOLUTE is the hard ceiling from the moment of
# login, so a stolen session cannot be kept alive indefinitely by touching the
# site. IDLE ends a session left open on an unattended workstation. Idle must not
# exceed absolute.
SESSION_ABSOLUTE_SECONDS=7200
SESSION_IDLE_SECONDS=1800

# Deny sign-in to an identity with no group mapped in
# shared/auth-groups.config.json. Keep this true: with it false, an unentitled
# user gets a session and an interface that refuses every action, instead of one
# clear refusal at the door. Set false only to debug a groups claim that is not
# arriving.
SSO_REQUIRE_GROUP=true

# Pushed Authorization Requests: send the authorization parameters to the
# provider back-channel instead of through the browser's URL bar, so they cannot
# be tampered with or logged by an intermediary. The provider must advertise
# pushed_authorization_request_endpoint in its discovery document; the server
# will not start if it does not.
SSO_PAR=false

# Accept provider-initiated (back-channel) logout tokens, so ending the session
# at the provider also ends it here. Requires provider support and the provider
# pointed at <BASE_URL>/backchannel-logout.
SSO_BACKCHANNEL_LOGOUT=false
